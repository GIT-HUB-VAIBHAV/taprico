---
import { SITE } from '../../config/site';
import { getToolsByCategory } from '../../config/tools';
import { GUIDES } from '../../data/guides';

const devTools = getToolsByCategory('developer');
const freelanceTools = getToolsByCategory('freelance');
---

<footer class="no-print border-t border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-[#060912]">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-12">
      <!-- Brand Summary -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-950 border border-indigo-500/40">
            <svg class="h-4 w-4" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M16 18H48V26H36V48H28V26H16V18Z" fill="#818CF8"/>
              <circle cx="45" cy="43" r="5" fill="#10B981"/>
            </svg>
          </div>
          <span class="text-base font-bold text-slate-900 dark:text-white">{SITE.name}</span>
        </a>
        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400 max-w-sm">
          Fast, privacy-first browser utilities built for US software engineers, DevOps teams, freelancers, and small businesses. Zero sign-ups, zero server uploads.
        </p>
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/25 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-300">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          100% Client-Side Computation
        </div>
      </div>

      <!-- Developer Studio Links -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Developer Studio
        </h3>
        <ul class="mt-4 space-y-2.5">
          {devTools.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}/`}
                class="text-sm text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
              >
                {tool.shortName}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Freelance & Guides -->
      <div class="lg:col-span-3">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Freelance Finance
        </h3>
        <ul class="mt-4 space-y-2.5">
          {freelanceTools.map((tool) => (
            <li>
              <a
                href={`/tools/${tool.slug}/`}
                class="text-sm text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >
                {tool.shortName}
              </a>
            </li>
          ))}
          <li>
            <a href="/salary/" class="text-sm text-slate-600 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
              US Salary Chart ($25–$150/hr)
            </a>
          </li>
          <li>
            <a href="/cron/" class="text-sm text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
              Cron Expression Library
            </a>
          </li>
        </ul>

        <h3 class="mt-7 text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Playbooks
        </h3>
        <ul class="mt-3 space-y-2">
          {GUIDES.slice(0, 2).map((g) => (
            <li>
              <a
                href={`/guides/${g.slug}/`}
                class="text-sm text-slate-600 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors line-clamp-1"
              >
                {g.title}
              </a>
            </li>
          ))}
          <li>
            <a href="/guides/" class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
              Browse all playbooks →
            </a>
          </li>
        </ul>
      </div>

      <!-- Company & Legal -->
      <div class="lg:col-span-2">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Trust &amp; Legal
        </h3>
        <ul class="mt-4 space-y-2.5">
          <li><a href="/about/" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">About Taprico</a></li>
          <li><a href="/contact/" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">Contact &amp; Support</a></li>
          <li><a href="/privacy-policy/" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">Terms of Service</a></li>
          <li><a href="/sitemap-index.xml" class="text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white">XML Sitemap</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200 dark:border-slate-800/80 pt-8 sm:flex-row text-xs text-slate-500 dark:text-slate-400">
      <p>&copy; {SITE.copyrightYear} {SITE.name} ({SITE.domain}). Built for fast, private browser workflows.</p>
      <p>Financial calculators are informational estimates; consult a licensed CPA for tax filings.</p>
    </div>
  </div>
</footer>
