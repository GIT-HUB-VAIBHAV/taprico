---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getToolsByCategory } from '../../config/tools';

const devTools = getToolsByCategory('developer');
const freelanceTools = getToolsByCategory('freelance');
---

<BaseLayout
  title="All Developer & Freelance Business Tools | Taprico"
  description="Browse all 12 browser-based tools on Taprico: JSON/YAML formatter, JWT decoder, Cron builder, Regex tester, SQL formatter, Diff checker, PDF Invoice Generator, and US Freelance Calculators."
  canonicalPath="/tools/"
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-12">
    <div class="max-w-3xl space-y-3">
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
        Complete Directory
      </span>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        Every Taprico Workbench Tool
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Every utility runs 100% locally in your browser tab with zero sign-ups, zero server storage, and instant results.
      </p>
    </div>

    <!-- Developer Studio -->
    <div id="developer" class="space-y-4">
      <div class="flex items-center gap-3">
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Developer Studio</h2>
        <span class="rounded-full bg-indigo-500/15 border border-indigo-500/30 px-2.5 py-0.5 font-mono text-xs font-semibold text-indigo-600 dark:text-indigo-300">
          8 Tools
        </span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {devTools.map((tool) => (
          <a
            href={`/tools/${tool.slug}/`}
            class="group flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-5 hover:border-indigo-500/60 transition-all"
          >
            <div>
              <span class="inline-block rounded bg-indigo-500/10 border border-indigo-500/20 px-2 py-0.5 font-mono text-[10px] font-semibold text-indigo-600 dark:text-indigo-300">
                {tool.badge}
              </span>
              <h3 class="mt-3 text-base font-bold text-slate-900 dark:text-white group-hover:text-indigo-500">
                {tool.shortName}
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">{tool.tagline}</p>
            </div>
            <div class="mt-4 text-xs font-semibold text-indigo-600 dark:text-indigo-400">Open Tool →</div>
          </a>
        ))}
      </div>
    </div>

    <!-- Freelance Finance -->
    <div id="freelance" class="space-y-4 pt-4">
      <div class="flex items-center gap-3">
        <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Freelance &amp; Small Business Finance</h2>
        <span class="rounded-full bg-emerald-500/15 border border-emerald-500/30 px-2.5 py-0.5 font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-300">
          4 Tools
        </span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {freelanceTools.map((tool) => (
          <a
            href={`/tools/${tool.slug}/`}
            class="group flex flex-col justify-between rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-5 hover:border-emerald-500/60 transition-all"
          >
            <div>
              <span class="inline-block rounded bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 font-mono text-[10px] font-semibold text-emerald-600 dark:text-emerald-300">
                {tool.badge}
              </span>
              <h3 class="mt-3 text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-500">
                {tool.shortName}
              </h3>
              <p class="mt-1.5 text-xs leading-relaxed text-slate-600 dark:text-slate-400">{tool.tagline}</p>
            </div>
            <div class="mt-4 text-xs font-semibold text-emerald-600 dark:text-emerald-400">Open Tool →</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
