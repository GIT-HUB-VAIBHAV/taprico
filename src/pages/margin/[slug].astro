---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/layout/AdSlot.astro';
import ProfitMarginCalculator from '../../components/tools/ProfitMarginCalculator';
import { MARGIN_PAGES, type MarginPageItem } from '../../data/marginPages';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return MARGIN_PAGES.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

interface Props {
  item: MarginPageItem;
}

const { item } = Astro.props;
const canonicalPath = `/margin/${item.slug}/`;
const fullUrl = new URL(canonicalPath, SITE.url).toString();

const price = item.sampleCost / (1 - item.marginPct / 100);
const grossProfit = price - item.sampleCost;
const stripeFee = price * 0.029 + 0.3;
const netAfterStripe = grossProfit - stripeFee;
const netMarginAfterStripe = (netAfterStripe / price) * 100;
const breakEvenRoas = (100 / item.marginPct).toFixed(2);
const multiplier = (1 / (1 - item.marginPct / 100)).toFixed(3);

function usd(n: number) {
  return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(n);
}

const faqs = [
  {
    question: `How do you calculate a ${item.marginPct}% profit margin from cost?`,
    answer: `Divide your unit cost by ${(1 - item.marginPct / 100).toFixed(2)} (equivalent to multiplying cost by ${multiplier}, or adding a ${item.markupPct}% markup). On a ${usd(item.sampleCost)} cost, your selling price for a ${item.marginPct}% margin is ${usd(price)}.`,
  },
  {
    question: `What is the difference between a ${item.marginPct}% margin and a ${item.marginPct}% markup?`,
    answer: `A ${item.marginPct}% markup on ${usd(item.sampleCost)} only sells for ${usd(item.sampleCost * (1 + item.marginPct / 100))} and leaves a smaller gross margin. To actually keep ${item.marginPct}% of selling revenue as gross profit, you must apply a ${item.markupPct}% markup.`,
  },
  {
    question: `What is the break-even ROAS at a ${item.marginPct}% gross margin?`,
    answer: `At a ${item.marginPct}% gross margin, your break-even Return on Ad Spend (ROAS) is ${breakEvenRoas}x before payment processing fees.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Margin Calculators', item: `${SITE.url}/margin/` },
    { '@type': 'ListItem', position: 3, name: `${item.marginPct}% Margin`, item: fullUrl },
  ],
};
---

<BaseLayout
  title={item.seoTitle}
  description={item.seoDescription}
  canonicalPath={canonicalPath}
  keywords={[
    `${item.marginPct} percent margin`,
    `${item.marginPct} margin markup`,
    'profit margin calculator',
    'gross margin vs markup',
  ]}
  schemas={[faqSchema, breadcrumbSchema]}
>
  <section class="border-b border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-[#090e1b]">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-3">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-indigo-500">Home</a>
        <span>/</span>
        <a href="/margin/" class="hover:text-indigo-500">Margin Reference</a>
        <span>/</span>
        <span class="font-medium text-slate-800 dark:text-slate-200">{item.marginPct}% Margin</span>
      </nav>
      <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        {item.title}
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
        {item.context}
      </p>
    </div>
  </section>

  <AdSlot slotKey="toolTopLeaderboard" />

  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <ProfitMarginCalculator
      initialMode="cost-margin"
      initialCost={item.sampleCost}
      initialMargin={item.marginPct}
      client:load
    />
  </section>

  <AdSlot slotKey="toolInContent" />

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8 space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-4">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">
            {item.marginPct}% Margin Cheat Sheet &amp; US Stripe Fee Impact
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
            <div class="rounded-xl bg-slate-50 dark:bg-slate-900/70 p-3.5">
              <div class="text-[11px] text-slate-500 uppercase font-semibold">Required Markup</div>
              <div class="font-mono text-lg font-black text-indigo-600 dark:text-indigo-400">{item.markupPct}%</div>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-slate-900/70 p-3.5">
              <div class="text-[11px] text-slate-500 uppercase font-semibold">Cost Multiplier</div>
              <div class="font-mono text-lg font-black text-slate-900 dark:text-white">{multiplier}×</div>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-slate-900/70 p-3.5">
              <div class="text-[11px] text-slate-500 uppercase font-semibold">Break-Even ROAS</div>
              <div class="font-mono text-lg font-black text-emerald-600 dark:text-emerald-400">{breakEvenRoas}×</div>
            </div>
            <div class="rounded-xl bg-slate-50 dark:bg-slate-900/70 p-3.5">
              <div class="text-[11px] text-slate-500 uppercase font-semibold">After 2.9%+$0.30</div>
              <div class="font-mono text-lg font-black text-amber-600 dark:text-amber-400">{netMarginAfterStripe.toFixed(1)}%</div>
            </div>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
            On a {usd(item.sampleCost)} COGS item priced at {usd(price)} ({item.marginPct}% margin = {usd(grossProfit)} gross profit), standard US card processing (2.9% + $0.30) deducts {usd(stripeFee)}, leaving {usd(netAfterStripe)} net before ads and shipping. Typical fit: {item.industryFit}
          </p>
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-3">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Frequently Asked Questions</h2>
          <div class="divide-y divide-slate-200 dark:divide-slate-800">
            {faqs.map((faq, idx) => (
              <details class="group py-3.5" open={idx === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 dark:text-white">
                  <span>{faq.question}</span>
                  <span class="text-indigo-500 text-lg leading-none">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
            Compare Other Target Margins
          </h3>
          <div class="grid grid-cols-2 gap-2">
            {MARGIN_PAGES.map((other) => (
              <a
                href={`/margin/${other.slug}/`}
                class={`rounded-lg border px-3 py-2 text-xs font-mono font-semibold transition-colors ${
                  other.marginPct === item.marginPct
                    ? 'border-emerald-500 bg-emerald-500/15 text-emerald-700 dark:text-emerald-300'
                    : 'border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-indigo-400'
                }`}
              >
                {other.marginPct}% ({other.markupPct}% mkp)
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
