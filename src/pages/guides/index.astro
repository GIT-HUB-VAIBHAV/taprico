---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES } from '../../data/guides';
---

<BaseLayout
  title="Engineering & Freelance Playbooks | Taprico"
  description="In-depth guides for US software engineers and freelancers covering 1099 pricing, JSON vs YAML configs, JWT authentication security, and US invoicing standards."
  canonicalPath="/guides/"
>
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8 space-y-10">
    <div class="space-y-3">
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">
        Playbooks &amp; Technical Guides
      </span>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        Field Guides for Builders &amp; Independent Consultants
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl">
        Practical checklists, US freelance tax &amp; pricing math, and backend security primers written to pair directly with our browser workbenches.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5">
      {GUIDES.map((g) => (
        <a
          href={`/guides/${g.slug}/`}
          class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 sm:p-7 hover:border-indigo-500/60 transition-all space-y-3"
        >
          <div class="flex flex-wrap items-center gap-3 text-xs">
            <span class="rounded-md bg-indigo-500/10 border border-indigo-500/20 px-2.5 py-0.5 font-mono font-semibold text-indigo-600 dark:text-indigo-300">
              {g.category}
            </span>
            <span class="text-slate-500 dark:text-slate-400">{g.readingTime}</span>
            <span class="text-slate-400">· Updated {g.updatedAt}</span>
          </div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-indigo-500 transition-colors">
            {g.title}
          </h2>
          <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">{g.excerpt}</p>
          <div class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 pt-1">Read Playbook →</div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
