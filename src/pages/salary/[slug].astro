---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/layout/AdSlot.astro';
import HourlySalaryConverter from '../../components/tools/HourlySalaryConverter';
import { SALARY_TIERS, type SalaryTier } from '../../data/salaryPages';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return SALARY_TIERS.map((tier) => ({
    params: { slug: tier.slug },
    props: { tier },
  }));
}

interface Props {
  tier: SalaryTier;
}

const { tier } = Astro.props;
const canonicalPath = `/salary/${tier.slug}/`;
const fullUrl = new URL(canonicalPath, SITE.url).toString();

const annualFull = tier.rate * 2080;
const annualTwoWeeksOff = tier.rate * (40 * 50);
const annualFourWeeksOff = tier.rate * (40 * 48);
const monthly = annualFull / 12;
const semiMonthly = annualFull / 24;
const biWeekly = annualFull / 26;
const weekly = tier.rate * 40;
const daily = tier.rate * 8;
const contractorParity = Math.round(((annualFull * 1.26) / 1872) * 100) / 100;

function usd(n: number, dec = 0) {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: dec,
    maximumFractionDigits: dec,
  }).format(n);
}

const faqs = [
  {
    question: `$${tier.rate} an hour is how much a year in the US?`,
    answer: `At a standard 40-hour US workweek across 52 weeks (2,080 hours), $${tier.rate} an hour equals ${usd(annualFull)} gross per year before taxes. If you take 2 weeks of unpaid vacation, it equals ${usd(annualTwoWeeksOff)} per year.`,
  },
  {
    question: `How much is $${tier.rate} an hour per month and bi-weekly?`,
    answer: `Making $${tier.rate}/hr full-time equals ${usd(monthly, 2)} gross per month (12 pay periods), ${usd(semiMonthly, 2)} semi-monthly (24 pay periods), and ${usd(biWeekly, 2)} every two weeks (26 bi-weekly paychecks).`,
  },
  {
    question: `Is $${tier.rate}/hr W-2 the same as $${tier.rate}/hr as a 1099 contractor?`,
    answer: `No. Independent 1099 contractors pay the extra 7.65% employer share of FICA taxes and receive zero paid PTO or health insurance. To match a ${usd(annualFull)} W-2 package, a 1099 contractor typically needs to bill around ${usd(contractorParity, 2)}/hr.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Salary Index', item: `${SITE.url}/salary/` },
    { '@type': 'ListItem', position: 3, name: `$${tier.rate}/hr`, item: fullUrl },
  ],
};
---

<BaseLayout
  title={tier.seoTitle}
  description={tier.seoDescription}
  canonicalPath={canonicalPath}
  keywords={[
    `${tier.rate} an hour is how much a year`,
    `${tier.rate} dollars an hour annual salary`,
    `${tier.rate} per hour biweekly`,
    'hourly to salary calculator',
  ]}
  schemas={[faqSchema, breadcrumbSchema]}
>
  <!-- Header -->
  <section class="border-b border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-[#090e1b]">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-3">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-indigo-500">Home</a>
        <span>/</span>
        <a href="/salary/" class="hover:text-indigo-500">US Salary Brackets</a>
        <span>/</span>
        <span class="font-medium text-slate-800 dark:text-slate-200">${tier.rate}/hr</span>
      </nav>
      <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        {tier.title}
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
        {tier.tierContext}
      </p>
    </div>
  </section>

  <AdSlot slotKey="toolTopLeaderboard" />

  <!-- Pre-populated Interactive Converter -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <HourlySalaryConverter initialHourly={tier.rate} client:load />
  </section>

  <AdSlot slotKey="toolInContent" />

  <!-- Detailed Breakdown + PTO Sensitivity + Cross Links -->
  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8 space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-6">
        <!-- Paycheck Table -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-4">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">
            ${tier.rate}/Hour Paycheck Schedule (40 hrs/week)
          </h2>
          <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
            <table class="w-full text-left text-sm border-collapse">
              <thead class="bg-slate-50 dark:bg-slate-900/70 text-xs uppercase text-slate-500">
                <tr>
                  <th class="py-2.5 px-4">Pay Frequency</th>
                  <th class="py-2.5 px-4">With Paid PTO (52 wks)</th>
                  <th class="py-2.5 px-4">With 2 Wks Unpaid Off</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-mono tabular-nums text-xs sm:text-sm">
                <tr><td class="py-2.5 px-4 font-sans font-semibold">Annual Gross</td><td class="py-2.5 px-4 text-emerald-600 dark:text-emerald-400 font-bold">{usd(annualFull)}</td><td class="py-2.5 px-4">{usd(annualTwoWeeksOff)}</td></tr>
                <tr><td class="py-2.5 px-4 font-sans font-semibold">Monthly (12/yr)</td><td class="py-2.5 px-4">{usd(monthly, 2)}</td><td class="py-2.5 px-4">{usd(annualTwoWeeksOff / 12, 2)}</td></tr>
                <tr><td class="py-2.5 px-4 font-sans font-semibold">Semi-Monthly (24/yr)</td><td class="py-2.5 px-4">{usd(semiMonthly, 2)}</td><td class="py-2.5 px-4">{usd(annualTwoWeeksOff / 24, 2)}</td></tr>
                <tr><td class="py-2.5 px-4 font-sans font-semibold">Bi-Weekly (26/yr)</td><td class="py-2.5 px-4">{usd(biWeekly, 2)}</td><td class="py-2.5 px-4">{usd(annualTwoWeeksOff / 26, 2)}</td></tr>
                <tr><td class="py-2.5 px-4 font-sans font-semibold">Weekly (40 hrs)</td><td class="py-2.5 px-4">{usd(weekly, 2)}</td><td class="py-2.5 px-4">{usd(weekly, 2)}</td></tr>
                <tr><td class="py-2.5 px-4 font-sans font-semibold">Daily (8 hrs)</td><td class="py-2.5 px-4">{usd(daily, 2)}</td><td class="py-2.5 px-4">{usd(daily, 2)}</td></tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Taking 4 weeks unpaid time off (48 working weeks) lowers gross annual pay at ${tier.rate}/hr to <strong class="font-mono text-slate-800 dark:text-slate-200">{usd(annualFourWeeksOff)}</strong>.
            Typical US roles in this tier: {tier.typicalRoles}
          </p>
        </div>

        <!-- FAQ Accordion -->
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-3">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Frequently Asked Questions</h2>
          <div class="divide-y divide-slate-200 dark:divide-slate-800">
            {faqs.map((faq, idx) => (
              <details class="group py-3.5" open={idx === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 dark:text-white">
                  <span>{faq.question}</span>
                  <span class="text-indigo-500 text-lg leading-none">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Sidebar: Other Wage Brackets + Tools -->
      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
            Compare Nearby Hourly Rates
          </h3>
          <div class="grid grid-cols-2 gap-2">
            {SALARY_TIERS.map((other) => (
              <a
                href={`/salary/${other.slug}/`}
                class={`rounded-lg border px-3 py-2 text-xs font-mono font-semibold transition-colors ${
                  other.rate === tier.rate
                    ? 'border-emerald-500 bg-emerald-500/15 text-emerald-600 dark:text-emerald-300'
                    : 'border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-indigo-400'
                }`}
              >
                ${other.rate}/hr ({usd(other.rate * 2080)})
              </a>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-indigo-500/30 bg-indigo-500/10 p-6 space-y-3">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Freelancing at ${tier.rate}+/hr?</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Factor in US self-employment taxes and non-billable hours, or create a clean Net 30 US Letter PDF invoice.
          </p>
          <div class="flex flex-col gap-2 pt-1">
            <a href="/tools/freelance-rate-calculator/" class="rounded-xl bg-indigo-600 px-4 py-2 text-center text-xs font-bold text-white hover:bg-indigo-500">
              Open Freelance Rate Calc →
            </a>
            <a href="/tools/invoice-generator/" class="rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-2 text-center text-xs font-bold text-slate-800 dark:text-slate-100">
              Create Free PDF Invoice
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
