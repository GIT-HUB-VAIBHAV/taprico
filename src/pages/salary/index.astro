---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SALARY_TIERS } from '../../data/salaryPages';

function fmt(n: number) {
  return '$' + n.toLocaleString('en-US');
}
---

<BaseLayout
  title="US Hourly to Annual Salary Chart ($25 to $150/hr) | Taprico"
  description="Browse US hourly wage to annual salary breakdowns from $25/hr to $150/hr—including bi-weekly, monthly, unpaid PTO adjustments, and 1099 contractor rates."
  canonicalPath="/salary/"
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 space-y-8">
    <div class="space-y-3 max-w-3xl">
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
        US Compensation Index
      </span>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        US Hourly to Annual Salary Reference ($25–$150/hr)
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Click any hourly rate below for an interactive paycheck breakdown, unpaid time-off comparison, and W-2 vs. 1099 independent contractor parity check.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {SALARY_TIERS.map((t) => {
        const annual = t.rate * 2080;
        const monthly = Math.round(annual / 12);
        const biWeekly = Math.round(annual / 26);
        return (
          <a
            href={`/salary/${t.slug}/`}
            class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-5 hover:border-emerald-500/60 transition-all space-y-2"
          >
            <div class="flex items-center justify-between">
              <span class="font-mono text-xl font-black text-emerald-600 dark:text-emerald-400">${t.rate}/hr</span>
              <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 font-mono text-xs font-semibold text-slate-700 dark:text-slate-200">
                {fmt(annual)}/yr
              </span>
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400">
              {fmt(monthly)}/mo · {fmt(biWeekly)} bi-weekly
            </div>
            <div class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 pt-1 group-hover:underline">
              Full ${t.rate}/hr Breakdown →
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
