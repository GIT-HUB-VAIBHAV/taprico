---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { INVOICE_TEMPLATES } from '../../data/invoiceTemplates';
---

<BaseLayout
  title="Free US Profession Invoice Templates (Download Vector PDF) | Taprico"
  description="Browse 10 free US Letter PDF invoice templates for web developers, 1099 software engineers, marketing consultants, designers, copywriters, and fractional CFOs."
  canonicalPath="/invoice-template/"
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 space-y-8">
    <div class="space-y-3 max-w-3xl">
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
        US Billing &amp; Invoicing Library
      </span>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        Free Freelance Invoice Templates (Zero Watermarks)
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
        Choose your profession below to launch a pre-filled US Letter PDF invoice builder with industry-specific line items, Net 15/30 terms, Form W-9 fields, and ACH details.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {INVOICE_TEMPLATES.map((tpl) => {
        const sampleTotal = tpl.preset.items?.reduce((acc, i) => acc + i.quantity * i.rate, 0) ?? 0;
        return (
          <a
            href={`/invoice-template/${tpl.slug}/`}
            class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-5 hover:border-emerald-500/60 transition-all space-y-2.5"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                {tpl.preset.terms?.toUpperCase() ?? 'NET30'}
              </span>
              <span class="rounded-md bg-slate-100 dark:bg-slate-800 px-2 py-0.5 font-mono text-xs font-semibold text-slate-700 dark:text-slate-200">
                Sample ${sampleTotal.toLocaleString('en-US')}
              </span>
            </div>
            <h2 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
              {tpl.role}
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-2">
              Terms: {tpl.typicalTerms}
            </p>
            <div class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 pt-1">
              Customize &amp; Export PDF →
            </div>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
