---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/layout/AdSlot.astro';
import InvoiceGenerator from '../../components/tools/InvoiceGenerator';
import { INVOICE_TEMPLATES, type InvoiceTemplateItem } from '../../data/invoiceTemplates';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return INVOICE_TEMPLATES.map((tpl) => ({
    params: { slug: tpl.slug },
    props: { tpl },
  }));
}

interface Props {
  tpl: InvoiceTemplateItem;
}

const { tpl } = Astro.props;
const canonicalPath = `/invoice-template/${tpl.slug}/`;
const fullUrl = new URL(canonicalPath, SITE.url).toString();

const faqs = [
  {
    question: `What should a ${tpl.role.toLowerCase()} include on a US client invoice?`,
    answer: `Include your legal or LLC name matching your Form W-9, sequential invoice number, Issue and Due dates (${tpl.typicalTerms}), itemized project deliverables, and direct ACH routing details so US accounts payable teams pay faster.`,
  },
  {
    question: `Is this ${tpl.role.toLowerCase()} invoice template completely free without watermarks?`,
    answer: `Yes. Taprico generates crisp, unlimited US Letter (8.5 x 11 in) vector PDFs directly inside your browser with zero watermarks, zero signups, and local browser storage for your company defaults.`,
  },
  {
    question: `Does Taprico store my client names or invoice dollar amounts on a server?`,
    answer: `No. Every calculation and PDF export executes 100% locally in your browser memory—no client info or revenue numbers are ever transmitted to external servers.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Invoice Templates', item: `${SITE.url}/invoice-template/` },
    { '@type': 'ListItem', position: 3, name: tpl.role, item: fullUrl },
  ],
};
---

<BaseLayout
  title={tpl.seoTitle}
  description={tpl.seoDescription}
  canonicalPath={canonicalPath}
  keywords={[
    `${tpl.role.toLowerCase()} invoice template`,
    'free pdf invoice generator',
    'us freelance invoice template',
    'net 30 invoice pdf',
  ]}
  schemas={[faqSchema, breadcrumbSchema]}
>
  <section class="border-b border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-[#090e1b]">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-3">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:text-indigo-500">Home</a>
        <span>/</span>
        <a href="/invoice-template/" class="hover:text-indigo-500">Invoice Templates</a>
        <span>/</span>
        <span class="font-medium text-slate-800 dark:text-slate-200">{tpl.role}</span>
      </nav>
      <h1 class="text-2xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        {tpl.title}
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
        Pre-configured for <strong>{tpl.role}</strong> engagements ({tpl.typicalTerms}). Edit any field below and download an instant watermark-free US Letter PDF.
      </p>
    </div>
  </section>

  <AdSlot slotKey="toolTopLeaderboard" />

  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <InvoiceGenerator initialPreset={tpl.preset} client:load />
  </section>

  <AdSlot slotKey="toolInContent" />

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8 space-y-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-3">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">
            Billing Best Practices for {tpl.role}s
          </h2>
          <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc pl-5">
            {tpl.billingTips.map((tip) => (
              <li>{tip}</li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-3">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Frequently Asked Questions</h2>
          <div class="divide-y divide-slate-200 dark:divide-slate-800">
            {faqs.map((faq, idx) => (
              <details class="group py-3.5" open={idx === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-slate-900 dark:text-white">
                  <span>{faq.question}</span>
                  <span class="text-indigo-500 text-lg leading-none">+</span>
                </summary>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <aside class="lg:col-span-4 space-y-6">
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#0d1322] p-6 space-y-3">
          <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
            All Profession Templates
          </h3>
          <div class="flex flex-col gap-2">
            {INVOICE_TEMPLATES.map((other) => (
              <a
                href={`/invoice-template/${other.slug}/`}
                class={`rounded-lg border px-3 py-2 text-xs font-medium transition-colors ${
                  other.slug === tpl.slug
                    ? 'border-emerald-500 bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 font-bold'
                    : 'border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-indigo-400'
                }`}
              >
                {other.role}
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
