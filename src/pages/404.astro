---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | Taprico"
  description="The page you requested could not be found on Taprico."
  canonicalPath="/404/"
  noindex={true}
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center space-y-5">
    <div class="inline-flex rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 font-mono text-xs font-bold text-indigo-500">
      HTTP 404
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-slate-900 dark:text-white">Tool or Page Not Found</h1>
    <p class="text-sm text-slate-600 dark:text-slate-400">
      Press <kbd class="rounded border border-slate-300 dark:border-slate-700 px-1.5 py-0.5 font-mono text-xs">⌘K</kbd> to jump straight to any tool, or return to the Taprico Workbench.
    </p>
    <div class="flex justify-center gap-3 pt-2">
      <a href="/" class="rounded-xl bg-indigo-600 px-5 py-2.5 text-xs font-bold text-white hover:bg-indigo-500">
        Back to Home
      </a>
      <a href="/tools/" class="rounded-xl border border-slate-300 dark:border-slate-700 px-5 py-2.5 text-xs font-bold text-slate-700 dark:text-slate-200">
        Browse All Tools
      </a>
    </div>
  </section>
</BaseLayout>
